{
  "schemaVersion": 4,
  "cliVersion": "1.0.1",
  "key": "sxt",
  "name": "RC-Astro StarXTerminator",
  "displayName": "StarXTerminator",
  "mlVersion": 11,
  "license": {
    "status": "permanent",
    "valid": true,
    "message": "Permanently licensed."
  },
  "devices": [
    {
      "id": "auto",
      "kind": "auto",
      "device": "gpu0",
      "name": "Intel(R) Graphics"
    },
    {
      "id": "gpu0",
      "kind": "gpu",
      "name": "Intel(R) Graphics"
    },
    {
      "id": "gpu1",
      "kind": "gpu",
      "name": "NVIDIA RTX PRO 4000 Blackwell Generation Laptop GPU"
    },
    {
      "id": "cpu",
      "kind": "cpu"
    }
  ],
  "parameters": [
    {
      "label": "Tile Overlap",
      "name": "overlap",
      "flag": "--overlap",
      "description": "Fractional overlap between adjacent tiles",
      "type": "float",
      "precision": 2,
      "default": 0.2,
      "max": 0.5,
      "min": 0.0
    },
    {
      "label": "Generate Star Image",
      "name": "stars",
      "flag": "--stars",
      "description": "Also write a stars-only image (original minus starless) beside the starless output",
      "type": "bool",
      "default": false
    },
    {
      "label": "Unscreen Stars",
      "name": "unscreen",
      "flag": "--unscreen",
      "description": "Unscreen stars (requires --output-stars)",
      "type": "bool",
      "default": false,
      "disabledIf": "!stars",
      "disabledValue": false
    }
  ],
  "groups": [
    {
      "name": "optionsGroup",
      "label": "Options",
      "params": [
        "stars",
        "unscreen"
      ]
    },
    {
      "name": "engineGroup",
      "label": "Engine",
      "params": [
        "overlap"
      ]
    }
  ]
}