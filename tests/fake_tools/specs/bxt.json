{
  "schemaVersion": 4,
  "cliVersion": "1.0.1",
  "key": "bxt",
  "name": "RC-Astro BlurXTerminator",
  "displayName": "BlurXTerminator",
  "mlVersion": 4,
  "license": {
    "status": "permanent",
    "valid": true,
    "message": "Permanently licensed."
  },
  "devices": [
    {
      "id": "auto",
      "kind": "auto",
      "device": "gpu0",
      "name": "Intel(R) Graphics"
    },
    {
      "id": "gpu0",
      "kind": "gpu",
      "name": "Intel(R) Graphics"
    },
    {
      "id": "gpu1",
      "kind": "gpu",
      "name": "NVIDIA RTX PRO 4000 Blackwell Generation Laptop GPU"
    },
    {
      "id": "cpu",
      "kind": "cpu"
    }
  ],
  "parameters": [
    {
      "label": "Tile Overlap",
      "name": "overlap",
      "flag": "--overlap",
      "description": "Fractional overlap between adjacent tiles",
      "type": "float",
      "precision": 2,
      "default": 0.2,
      "max": 0.5,
      "min": 0.0
    },
    {
      "label": "Sharpen Stars",
      "name": "ss",
      "flag": "--ss",
      "description": "Amount of stellar sharpening",
      "type": "float",
      "precision": 2,
      "default": 0.0,
      "max": 0.7,
      "min": 0.0
    },
    {
      "label": "Adjust Star Halos",
      "name": "ash",
      "flag": "--ash",
      "description": "Reduce or enlarge star halos",
      "type": "float",
      "precision": 2,
      "default": 0.0,
      "max": 0.5,
      "min": -0.5
    },
    {
      "label": "PSF Diameter",
      "name": "nsd",
      "flag": "--nsd",
      "description": "Manual nonstellar PSF diameter (must be 0.0 when auto-nonstellar-psf is true)",
      "type": "float",
      "precision": 1,
      "default": 0.0,
      "max": 8.0,
      "min": 0.0,
      "disabledIf": "ansp",
      "disabledValue": 0.0,
      "unit": "pixels"
    },
    {
      "label": "Automatic PSF",
      "name": "ansp",
      "flag": "--ansp",
      "description": "Estimate the nonstellar PSF automatically from stars in the image",
      "type": "bool",
      "default": true
    },
    {
      "label": "Sharpen Nonstellar",
      "name": "sn",
      "flag": "--sn",
      "description": "Amount of nonstellar sharpening",
      "type": "float",
      "precision": 2,
      "default": 0.0,
      "max": 1.0,
      "min": 0.0
    }
  ],
  "groups": [
    {
      "name": "stellarGroup",
      "label": "Stellar Adjustments",
      "params": [
        "ss",
        "ash"
      ]
    },
    {
      "name": "nonstellarGroup",
      "label": "Nonstellar Adjustments",
      "params": [
        "ansp",
        "nsd",
        "sn"
      ]
    },
    {
      "name": "optionsGroup",
      "label": "Options",
      "params": [],
      "modes": [
        "correctOnlyMode"
      ]
    },
    {
      "name": "engineGroup",
      "label": "Engine",
      "params": [
        "overlap"
      ]
    }
  ],
  "modes": [
    {
      "flag": "--correct-only",
      "name": "correctOnlyMode",
      "label": "Correct Only",
      "description": "Correct PSF aberrations without sharpening",
      "pins": {
        "ansp": true,
        "ash": 0.0,
        "nsd": 0.0,
        "sn": 0.0,
        "ss": 0.0
      }
    }
  ]
}